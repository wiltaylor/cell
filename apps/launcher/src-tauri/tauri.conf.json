{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cell Launcher",
  "version": "0.1.0",
  "identifier": "dev.wiltaylor.cell-launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cell Launcher",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"]
  }
}
