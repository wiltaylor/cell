// cell.wcl schema — the surface of a Cell build file.
//
// A build file opts in with `import <cell.wcl>` at the top. WCL rejects an
// unknown block or field; `cell validate` applies the rules the schema
// cannot express (paths exist, lists agree, and so on).

// The exact set of values a stringly-typed field accepts.
@decorator("options")
@applies_to(on = [:type_field])
type FieldOptions {
  @inline(0) values: list<utf8>
}

symbol_set Placement   { embedded sidecar referenced }
symbol_set Compression { zstd raw }
symbol_set HomeMode    { private portable host }
symbol_set PidMode     { private host }
symbol_set Sandbox     { appcontainer off }
symbol_set Display     { wayland x11 x11_fallback }
symbol_set Audio       { pipewire pulse alsa }
symbol_set Input       { gamepad uinput }
symbol_set Dbus        { off session }
symbol_set Nvidia      { auto fetch host off }
symbol_set BindKind    { ro rw dev }

@document
type CellDoc {
  @children("app")      apps:      list<App>
  @children("template") templates: list<Template>
}

@block("app")
type App {
  @doc("Reverse-DNS app id; names the state directory and the desktop entry")
  @inline(0) id: utf8
  @doc("Human name")
  name: utf8?
  @doc("Version string")
  version: utf8?
  @doc("CPU architecture of the payload")
  @options(["x86_64", "aarch64"]) arch: utf8?
  @doc("Target operating system. A windows cell is a .cell.exe headed by the Windows launcher; its runtime block is optional and may only use dir:// or tar:// bases")
  @options(["linux", "windows"]) os: utf8?
  @doc("Name of a template block whose settings this app starts from")
  template: utf8?
  @child("runtime")     runtime:     Runtime?
  @child("build")       build:       Build?
  @children("layer")    layers:      list<Layer>
  @child("entry")       entry:       Entry?
  @child("isolation")   isolation:   Isolation?
  @child("integration") integration: Integration?
  @child("registry")    registry:    RegistryDecl?
}

@block("template")
type Template {
  @inline(0) name: utf8
  @child("runtime")     runtime:     Runtime?
  @child("build")       build:       Build?
  @child("entry")       entry:       Entry?
  @child("isolation")   isolation:   Isolation?
  @child("integration") integration: Integration?
  @child("registry")    registry:    RegistryDecl?
}

@block("runtime")
type Runtime {
  @doc("Base system: oci://image (native registry pull), docker://image (docker export), tar://path-or-url, or dir://path")
  base: utf8
  @doc("Install 32-bit libraries too (Wine needs this)")
  @default(false) multilib: bool?
  @doc("embedded: inside the file; sidecar: in <name>.cell.d/; referenced: a content-addressed file beside the cell that other cells can share")
  @default(:embedded) placement: Placement?
  @doc("Packages installed with the base's own package manager")
  packages: list<utf8>?
  @doc("Shell commands run as root before the packages install")
  setup: list<utf8>?
}

@block("build")
type Build {
  @children("copy") copies: list<Copy>
  @children("run")  runs:   list<Run>
}

@block("copy")
type Copy {
  @doc("Host path, relative to the build file")
  from: utf8
  @doc("Path inside the image")
  to: utf8
}

@block("run")
type Run {
  @doc("Shell command run as root inside the image")
  @inline(0) command: utf8
}

@block("layer")
type Layer {
  @inline(0) name: utf8
  @doc("Host directory, relative to the build file")
  source: utf8
  @doc("Mount path inside the sandbox")
  mount: utf8
  @default(:zstd) compression: Compression?
  @default(:embedded) placement: Placement?
}

@block("entry")
type Entry {
  @doc("Command and arguments")
  exec: list<utf8>
  @doc("Working directory inside the sandbox")
  cwd: utf8?
  @doc("Wrap the command in gamescope")
  @default(false) gamescope: bool?
  @children("env")     envs:     list<EnvVar>
  @children("command") commands: list<NamedCommand>
}

@block("env")
type EnvVar {
  @inline(0) name: utf8
  value: utf8
}

@block("command")
type NamedCommand {
  @inline(0) name: utf8
  exec: list<utf8>
}

@block("isolation")
type Isolation {
  @doc("Share the host network namespace")
  @default(false) network: bool?
  @doc("private: per-app home in XDG_DATA_HOME; portable: beside the file; host: the real home")
  @default(:private) home: HomeMode?
  @default(:private) pid: PidMode?
  @doc("Windows only: run the app in an AppContainer, where network = false means no network and bind blocks become access grants on the host path; :off runs it as the user with no sandbox")
  @default(:appcontainer) sandbox: Sandbox?
  @doc("Share /dev/shm with the host")
  @default(false) shm: bool?
  @children("bind") binds: list<Bind>
}

@block("bind")
type Bind {
  @inline(0) kind: BindKind
  host: utf8
  guest: utf8
  @default(true) optional: bool?
}

@block("integration")
type Integration {
  display: list<Display>?
  audio:   list<Audio>?
  input:   list<Input>?
  @default(:off) dbus: Dbus?
  @doc("Expose host fonts under /run/host")
  @default(false) fonts: bool?
  @doc("Expose host icon and cursor themes under /run/host")
  @default(false) themes: bool?
  @child("gpu")     gpu:     Gpu?
  @child("desktop") desktop: DesktopEntry?
  @child("steam")   steam:   SteamEntry?
}

@block("registry")
type RegistryDecl {
  @doc("Windows only. A .reg file, relative to the build file, whose HKEY_CURRENT_USER keys the launcher writes before the app starts; deletions are rejected")
  import: utf8?
  @doc("Keys under HKEY_CURRENT_USER the sandbox may read and write, with nothing written to them, for example [\"HKCU/Software/Vendor/Shared\"]")
  grant: list<utf8>?
  @children("key") keys: list<RegistryKey>
}

@block("key")
type RegistryKey {
  @doc("Key path under HKEY_CURRENT_USER, written HKCU/Software/Vendor/App or HKEY_CURRENT_USER\\Software\\Vendor\\App. A value is written when it is missing, or at every start when it names $CELL_ROOT")
  @inline(0) path: utf8
  @children("value") values: list<RegistryValue>
}

@block("value")
type RegistryValue {
  @doc("Value name; \"@\" is the key's default value")
  @inline(0) name: utf8
  @doc("REG_SZ; $CELL_ROOT expands to the mounted root")
  string: utf8?
  @doc("REG_EXPAND_SZ; %VAR% expands when the app reads it")
  expand: utf8?
  @doc("REG_DWORD")
  dword: u32?
  @doc("REG_QWORD")
  qword: u64?
  @doc("REG_BINARY as hex digits, for example \"00ff10\"")
  hex: utf8?
  @doc("REG_MULTI_SZ")
  strings: list<utf8>?
}

@block("gpu")
type Gpu {
  @default(true)  enable: bool?
  @default(:auto) nvidia: Nvidia?
  @default(true)  vaapi:  bool?
}

@block("desktop")
type DesktopEntry {
  @doc("PNG icon, relative to the build file")
  icon: utf8?
  @doc("One-line description shown in menus")
  comment: utf8?
  @doc("Freedesktop menu categories, for example Game, SportsGame")
  categories: list<utf8>?
  @doc("MIME types the app opens")
  mime: list<utf8>?
  @doc("URL schemes the app handles, for example [\"mygame\"] for mygame:// links")
  protocols: list<utf8>?
  @doc("Search keywords for the launcher")
  keywords: list<utf8>?
}

@block("steam")
type SteamEntry {
  @doc("Library capsule PNG, 600x900, relative to the build file")
  portrait: utf8?
  @doc("Header capsule PNG, 920x430")
  wide: utf8?
  @doc("Library hero PNG, 1920x620")
  hero: utf8?
  @doc("Logo PNG with transparency, drawn over the hero")
  logo: utf8?
  @doc("Steam collection tags")
  tags: list<utf8>?
  @doc("Launch options for the Steam shortcut")
  launch_options: utf8?
}
